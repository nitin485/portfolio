    {
      "id": "rdbS2DuqbzhjFU89EUCWt",
      "type": "text",
      "x": 253.68212890625,
      "y": 3997.321746826172,
      "width": 504.9794921875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1999039823,
      "version": 2,
      "versionNonce": 621056801,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774250346688,
      "link": null,
      "locked": false,
      "text": "Trango is a leading provider of adventure travel\nexperiences, offering a wide range of trips and\ntours to destinations around the world. With a\nfocus on outdoor activities and cultural immersion,\nTrango provides travelers with unique and\nunforgettable experiences. Whether you're looking\nfor a challenging trek in the Himalayas, a wildlife\nsafari in Africa, or a cultural tour in South America,\nTrango has something for everyone. With\nexperienced guides and a commitment to responsible\ntourism, Trango is the perfect choice for your next\nadventure.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Trango is a leading provider of adventure travel experiences, offering a wide range of trips and tours to destinations around the world. With a focus on outdoor activities and cultural immersion, Trango provides travelers with unique and unforgettable experiences. Whether you're looking for a challenging trek in the Himalayas, a wildlife safari in Africa, or a cultural tour in South America, Trango has something for everyone. With experienced guides and a commitment to responsible tourism, Trango is the perfect choice for your next adventure.",
      "autoResize": false,
      "lineHeight": 1.25
    },
